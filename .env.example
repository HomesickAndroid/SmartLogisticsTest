# Фиксированные настройки проверочного стенда. Compose читает этот файл автоматически.
# Логины и пароли опубликованы в README. Личные переопределения — в .env, исключённом из Git.
POSTGRES_DB=deals_bigdata
POSTGRES_USER=logistics
POSTGRES_PASSWORD=local-postgres
CLICKHOUSE_PASSWORD=local-clickhouse
BI_PASSWORD=local-reader
ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=local-airflow
SUPERSET_ADMIN_PASSWORD=local-superset
SUPERSET_SECRET_KEY=local-demo-superset-session-key-change-for-external-use
AIRFLOW_WEB_SECRET=local-demo-airflow-session-key
AIRFLOW_FERNET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

AS_OF=2026-10-26
N_PRICES=300000
SEED=20261026
ML_ITERATIONS=450
ML_THREADS=4
POSTGRES_PORT=5432
CLICKHOUSE_PORT=8123
AIRFLOW_PORT=8080
SUPERSET_PORT=8088
# Начало периода включено, конец не включён; пустые значения означают весь источник.
START_DATE=
END_DATE=
